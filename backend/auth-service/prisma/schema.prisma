// Prisma-схема auth-service (УСТАВ.md → Агент Backend Auth, п.2).
// Роли совпадают с shared/types/roles.ts (OPERATOR | SUPERVISOR | MANAGER | ADMIN | CLIENT).

generator client {
  provider = "prisma-client-js"
  // Свой output на сервис: pnpm-стор не дедуплицирует клиенты между схемами.
  output   = "../node_modules/.prisma/client"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  OPERATOR
  SUPERVISOR
  MANAGER
  ADMIN
  CLIENT
}

model User {
  id            String         @id @default(uuid())
  email         String         @unique
  phone         String?        @unique
  passwordHash  String
  fullName      String
  role          Role           @default(OPERATOR)
  pinCode       String?
  biometricKey  String?
  avatarUrl     String?
  isActive      Boolean        @default(true)
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  refreshTokens RefreshToken[]

  @@map("users")
}

model RefreshToken {
  id        String    @id @default(uuid())
  token     String    @unique
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime  @default(now())
  revokedAt DateTime?

  @@map("refresh_tokens")

  @@index([userId])
}
