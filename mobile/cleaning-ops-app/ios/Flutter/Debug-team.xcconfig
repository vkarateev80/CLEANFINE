// Продукт «CLEANFINE Команда» (flavor team): поды генерируются под конфигурации *-team.
#include? "Pods/Target Support Files/Pods-Runner/Pods-Runner.debug-team.xcconfig"
#include "Generated.xcconfig"

// Xcode собирает explicit-модули настройками того таргета, который их импортирует.
// Флаг стоит и у подов (post_install в Podfile), и здесь — у Runner.
CLANG_ALLOW_NON_MODULAR_INCLUDES_IN_FRAMEWORK_MODULES = YES
