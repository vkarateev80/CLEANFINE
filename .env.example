# ============================================================
# Cleaning Ops — шаблон окружения
# Копировать в .env (scripts/setup/setup.sh или setup.ps1)
# ============================================================

# --- Инфраструктура (docker compose, infra/docker) ---
POSTGRES_DB=cleaning_ops
POSTGRES_USER=admin
DB_PASSWORD=change-me
DATABASE_URL=postgresql://admin:change-me@localhost:5432/cleaning_ops?schema=public
# Отдельная БД на сервис (границы микросервисов). Создать вручную:
#   psql -U admin -c 'CREATE DATABASE cleaning_ops_files'
#   psql -U admin -c 'CREATE DATABASE cleaning_ops_core'
FILE_DATABASE_URL=postgresql://admin:change-me@localhost:5432/cleaning_ops_files?schema=public
CORE_DATABASE_URL=postgresql://admin:change-me@localhost:5432/cleaning_ops_core?schema=public

REDIS_URL=redis://localhost:6379

RABBITMQ_DEFAULT_USER=admin
RABBITMQ_PASSWORD=change-me
RABBITMQ_URL=amqp://admin:change-me@localhost:5672

# MinIO: root-креды сервера (compose) и S3-клиент сервисов — один пользователь,
# значения обязаны совпадать, иначе «Access Key Id does not exist».
MINIO_ROOT_USER=change-me
MINIO_ROOT_PASSWORD=change-me
MINIO_ENDPOINT=localhost
MINIO_PORT=9000
MINIO_USE_SSL=false
MINIO_ACCESS_KEY=change-me
MINIO_SECRET_KEY=change-me
# Базовый URL файлов в ответах API (в проде — публичный домен/CDN)
# MINIO_PUBLIC_URL=http://localhost:9000

# --- Auth (JWT) ---
JWT_ACCESS_SECRET=change-me-access
JWT_REFRESH_SECRET=change-me-refresh
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d

# --- Firebase (dev: используется мок-адаптер, см. ПЛАН.md, решение №3) ---
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# --- Frontend ---
# ВНИМАНИЕ: корневой .env НЕ читается Vite. В dev web-admin использует
# относительный /api, а vite.config.ts раскидывает его по сервисам
# (auth :3001, files :3002, core :3003).
#
# Для прод-сборки одной переменной уже недостаточно: запросы идут в три разных
# сервиса, поэтому VITE_API_URL должен указывать на ОБЩИЙ префикс за
# reverse-proxy (nginx), который повторяет маршрутизацию dev-прокси.
# Прямое «http://host:3001/api» сломает вызовы core-service (:3003).
VITE_API_URL=/api
VITE_WS_URL=http://localhost:3001

# --- Таймеры эскалации заявок (минуты; в тестах сокращаются) ---
ESCALATION_NEW_TO_ACCEPT_MIN=5
ESCALATION_ACCEPT_TO_ARRIVE_MIN=15
ESCALATION_ARRIVE_TO_DONE_MIN=60
