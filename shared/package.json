{
  "name": "@cleaning-ops/shared",
  "version": "0.1.0",
  "private": true,
  "description": "Общие типы, константы и контракты событий Cleaning Ops (изменения — только с review архитектора)",
  "type": "module",
  "main": "./dist/constants/events.js",
  "types": "./dist/constants/events.d.ts",
  "exports": {
    "./types/*": {
      "types": "./dist/types/*.d.ts",
      "import": "./dist/types/*.js",
      "require": "./dist/types/*.js",
      "default": "./dist/types/*.js"
    },
    "./constants/*": {
      "types": "./dist/constants/*.d.ts",
      "import": "./dist/constants/*.js",
      "require": "./dist/constants/*.js",
      "default": "./dist/constants/*.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsc -b --force",
    "typecheck": "tsc -b --noEmit"
  },
  "devDependencies": {
    "typescript": "^5.4.5"
  }
}
