          "expr": "sum by (entry) (label_replace(rate(traefik_service_requests_total[5m]), \"entry\", \"$1\", \"exported_service\", \"(?:cleaning-ops|monitoring)-(?:cleanfine-|kps-)?([a-z]+(?:-[a-z]+)?)(?:-[0-9a-f]+)?@.*\")) * 60",
          "legendFormat": "{{entry}}",
          "range": true
        }
      ],
      "description": "API всех сервисов идёт через вход «Админка + API» (nginx админки)",
      "fieldConfig": {
        "defaults": {
          "unit": "short",
