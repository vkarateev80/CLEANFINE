{
  "uid": "cf-services",
  "title": "CLEANFINE — сервисы",
  "description": "Здоровье сервисов CLEANFINE: трафик через Traefik, ошибки, время ответа, ресурсы подов и сервера",
  "tags": [
    "cleanfine"
  ],
  "timezone": "browser",
  "editable": true,
  "refresh": "1m",
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "schemaVersion": 39,
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "Недоступных реплик",
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 4,
        "h": 4
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum(kube_deployment_status_replicas_unavailable{namespace=\"cleaning-ops\"}) + sum(kube_statefulset_status_replicas{namespace=\"cleaning-ops\"} - kube_statefulset_status_replicas_ready{namespace=\"cleaning-ops\"})",
          "legendFormat": "",
          "range": false,
          "instant": true
        }
      ],
      "description": "Сервисы CLEANFINE, у которых не поднялись поды",
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "decimals": 0,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "value": null,
                "color": "green"
              },
              {
                "value": 1,
                "color": "red"
              }
            ]
          },
          "color": {
            "mode": "thresholds"
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "background",
        "graphMode": "none",
        "textMode": "value",
        "justifyMode": "center"
      }
    },
