    {
      "id": 10,
      "type": "table",
      "title": "Маршруты сегодня",
      "gridPos": {
        "x": 0,
        "y": 11,
        "w": 24,
        "h": 7
      },
      "datasource": {
        "type": "datasource",
        "uid": "-- Mixed --"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "cf-pg-tickets"
          },
          "rawSql": "SELECT t.\"assigneeId\" AS \"userId\", CASE t.status WHEN 'new' THEN 'Новая' WHEN 'assigned' THEN 'Назначена' WHEN 'in_progress' THEN 'В работе' WHEN 'paused' THEN 'Пауза' WHEN 'completed' THEN 'Выполнена' WHEN 'verified' THEN 'Проверена' WHEN 'rejected' THEN 'Отклонена' WHEN 'closed' THEN 'Закрыта' WHEN 'overdue' THEN 'Просрочена' END AS \"Статус\", COALESCE(oc.done, 0) AS \"Операций\", t.\"operationsTotal\" AS \"Всего операций\", round(100.0 * COALESCE(oc.done, 0) / NULLIF(t.\"operationsTotal\", 0)) AS \"Готово, %\", COALESCE(rc.done, 0) AS \"Помещений закрыто\", COALESCE(oc.photos, 0) AS \"Фото\", to_char(GREATEST(oc.last, rc.last) AT TIME ZONE 'UTC' AT TIME ZONE ${tz:sqlstring}, 'HH24:MI') AS \"Последняя отметка\", to_char(t.\"createdAt\" AT TIME ZONE 'UTC' AT TIME ZONE ${tz:sqlstring}, 'DD.MM HH24:MI') AS \"Заявка создана\" FROM tickets t LEFT JOIN (SELECT \"ticketId\", count(*) AS done, count(\"photoUrl\") AS photos, max(\"completedAt\") AS last FROM ticket_operation_completions GROUP BY 1) oc ON oc.\"ticketId\" = t.id LEFT JOIN (SELECT \"ticketId\", count(*) AS done, max(\"completedAt\") AS last FROM ticket_room_completions GROUP BY 1) rc ON rc.\"ticketId\" = t.id WHERE t.type = 'planned' AND ((t.\"createdAt\" AT TIME ZONE 'UTC' AT TIME ZONE ${tz:sqlstring})::date = (now() AT TIME ZONE ${tz:sqlstring})::date OR t.status IN ('in_progress', 'paused')) ORDER BY t.\"createdAt\"",
          "format": "table",
          "rawQuery": true,
          "editorMode": "code"
        },
        {
          "refId": "U",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "cf-pg-auth"
          },
          "rawSql": "SELECT id AS \"userId\", \"fullName\" AS \"Сотрудник\" FROM users",
          "format": "table",
          "rawQuery": true,
          "editorMode": "code"
        }
      ],
      "description": "Плановые заявки смен: сколько операций чек-листа отмечено, сколько помещений закрыто и фото",
      "transformations": [
        {
          "id": "joinByField",
          "options": {
            "byField": "userId",
            "mode": "inner"
          }
        },
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "userId": true
            },
            "renameByName": {},
            "indexByName": {
              "Сотрудник": 0,
              "Статус": 1,
              "Готово, %": 2,
              "Операций": 3,
              "Всего операций": 4,
              "Помещений закрыто": 5,
              "Фото": 6,
              "Последняя отметка": 7,
              "Заявка создана": 8
            }
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "align": "auto",
            "cellOptions": {
              "type": "auto"
            }
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "Готово, %"
            },
            "properties": [
              {
                "id": "unit",
                "value": "percent"
              },
              {
                "id": "min",
                "value": 0
              },
              {
                "id": "max",
                "value": 100
              },
              {
