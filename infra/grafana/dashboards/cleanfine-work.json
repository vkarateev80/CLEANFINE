      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "cf-pg-tickets"
          },
          "rawSql": "SELECT left(t.id, 8) AS \"Заявка\", CASE t.type WHEN 'planned' THEN 'Плановая' WHEN 'unscheduled' THEN 'Внеплановая' WHEN 'emergency' THEN 'SOS' ELSE t.type::text END AS \"Тип\", CASE t.priority::text WHEN 'critical' THEN 'Критичный' WHEN 'high' THEN 'Высокий' WHEN 'normal' THEN 'Обычный' WHEN 'low' THEN 'Низкий' ELSE t.priority::text END AS \"Приоритет\", CASE t.status WHEN 'new' THEN 'Новая' WHEN 'assigned' THEN 'Назначена' WHEN 'in_progress' THEN 'В работе' WHEN 'paused' THEN 'Пауза' WHEN 'overdue' THEN 'Просрочена' ELSE t.status::text END AS \"Статус\", t.\"assigneeId\" AS \"userId\", to_char(t.\"createdAt\" AT TIME ZONE 'UTC' AT TIME ZONE ${tz:sqlstring}, 'DD.MM HH24:MI') AS \"Создана\", left(t.description, 80) AS \"Описание\" FROM tickets t WHERE t.status IN ('new', 'assigned', 'in_progress', 'paused', 'overdue') ORDER BY (t.type = 'emergency') DESC, (t.status = 'overdue') DESC, t.\"createdAt\" DESC LIMIT 100",
          "format": "table",
          "rawQuery": true,
          "editorMode": "code"
        },
