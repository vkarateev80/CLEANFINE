    {
      "id": 9,
      "type": "table",
      "title": "Смены сегодня",
      "gridPos": {
        "x": 0,
        "y": 4,
        "w": 24,
        "h": 7
      },
      "datasource": {
        "type": "datasource",
        "uid": "-- Mixed --"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "cf-pg-schedule"
          },
          "rawSql": "SELECT to_char(e.\"plannedStart\" AT TIME ZONE 'UTC' AT TIME ZONE ${tz:sqlstring}, 'HH24:MI') AS \"Начало\", s.name AS \"График\", e.\"userId\" AS \"userId\", CASE e.status WHEN 'PLANNED' THEN 'Запланирована' WHEN 'CHECKED_IN' THEN 'На смене' WHEN 'CHECKED_OUT' THEN 'Закрыта' WHEN 'MISSED' THEN 'Неявка' END AS \"Статус\", to_char(e.\"checkInAt\" AT TIME ZONE 'UTC' AT TIME ZONE ${tz:sqlstring}, 'HH24:MI') AS \"Пришёл\", to_char(e.\"checkOutAt\" AT TIME ZONE 'UTC' AT TIME ZONE ${tz:sqlstring}, 'HH24:MI') AS \"Ушёл\", CASE WHEN f.late THEN f.lateness_minutes END AS \"Опоздание, мин\", CASE WHEN e.\"checkOutReason\" IS NOT NULL THEN 'автоматически' END AS \"Закрыта\" FROM \"ScheduleEvent\" e JOIN \"Schedule\" s ON s.id = e.\"scheduleId\" LEFT JOIN staff_shift_fact f ON f.event_id = e.id WHERE e.\"date\"::date = (now() AT TIME ZONE ${tz:sqlstring})::date OR e.status = 'CHECKED_IN' ORDER BY e.\"plannedStart\"",
          "format": "table",
          "rawQuery": true,
          "editorMode": "code"
        },
        {
          "refId": "U",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "cf-pg-auth"
          },
          "rawSql": "SELECT id AS \"userId\", \"fullName\" AS \"Сотрудник\" FROM users",
          "format": "table",
          "rawQuery": true,
          "editorMode": "code"
        }
      ],
      "description": "Смены сегодняшнего дня по поясу организации и открытые смены прошлых дней",
      "transformations": [
        {
          "id": "joinByField",
          "options": {
            "byField": "userId",
            "mode": "inner"
          }
        },
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "userId": true
            },
            "renameByName": {},
            "indexByName": {
              "Начало": 0,
              "Сотрудник": 1,
              "График": 2,
              "Статус": 3,
              "Пришёл": 4,
              "Ушёл": 5,
              "Опоздание, мин": 6,
              "Закрыта": 7
            }
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "align": "auto",
            "cellOptions": {
              "type": "auto"
            }
          }
