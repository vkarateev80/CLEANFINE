    {
      "id": 11,
      "type": "timeseries",
      "title": "Заявки по дням",
      "gridPos": {
        "x": 0,
        "y": 18,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "cf-pg-tickets"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "cf-pg-tickets"
          },
          "rawSql": "SELECT day::timestamp AS time, sum(created_count) AS \"Создано\", sum(completed_count) AS \"Выполнено\", sum(overdue_count) AS \"Просрочено\" FROM ticket_execution_daily WHERE day BETWEEN $__timeFrom()::date AND $__timeTo()::date GROUP BY day ORDER BY day",
          "format": "time_series",
          "rawQuery": true,
          "editorMode": "code"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "drawStyle": "bars",
            "fillOpacity": 70,
            "lineWidth": 1,
            "barAlignment": 0,
