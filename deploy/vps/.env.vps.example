# ============================================================
# Cleaning Ops — шаблон окружения изолированного стенда prj-cleanfine.
#
# НЕ РЕДАКТИРУЙТЕ этот файл для стенда: он коммитится в git и содержит только
# плейсхолдеры __CHANGE_ME__. Рабочий файл .env.vps создаёт
# `bash deploy/vps/gen-env.sh` (секреты — openssl rand -hex), он же в .gitignore
# (FR-7, FR-8, AC-7).
#
# Состав переменных — System Design v2, §5 (матрица переменных) и PRD FR-6.
# Формат имён: <SERVICE>_DATABASE_URL — по одной БД на сервис, connection_limit=8
# обязателен (9 × 8 = 72 соединения при max_connections=100 у postgres).
# ============================================================

# --- Инфраструктура ---------------------------------------------------------
POSTGRES_DB=cleaning_ops
POSTGRES_USER=admin
# <GEN> gen-env.sh: openssl rand -hex 24 (48 hex-символов)
DB_PASSWORD=__CHANGE_ME__

RABBITMQ_DEFAULT_USER=admin
# <GEN> gen-env.sh: openssl rand -hex 24
RABBITMQ_PASSWORD=__CHANGE_ME__

# MinIO: MINIO_ROOT_* (сервер) и MINIO_ACCESS_KEY/MINIO_SECRET_KEY (S3-клиент
# file-service) обязаны совпадать, иначе «Access Key Id does not exist».
MINIO_ROOT_USER=admin
# <GEN> gen-env.sh: openssl rand -hex 24
MINIO_ROOT_PASSWORD=__CHANGE_ME__
MINIO_ACCESS_KEY=admin
# <GEN> gen-env.sh: то же значение, что MINIO_ROOT_PASSWORD
MINIO_SECRET_KEY=__CHANGE_ME__
MINIO_ENDPOINT=minio
MINIO_PORT=9000
MINIO_USE_SSL=false
# Публичный адрес файлов в ответах API (ADR-3 / решение O2): MinIO опубликован
# в tailnet на 8120, иначе URL http://minio:9000/... не открывается из браузера
# и планы этажей/фотоотчёты недоступны.
MINIO_PUBLIC_URL=http://100.109.185.14:8120

# Redis сейчас не читает ни один сервис (проверено grep'ом по backend/) —
# переменная оставлена для паритета с эталоном инфраструктуры.
REDIS_URL=redis://redis:6379

# --- БД на сервис (9 отдельных баз, FR-6) -----------------------------------
DATABASE_URL="postgresql://admin:__CHANGE_ME__@postgres:5432/cleaning_ops?schema=public&connection_limit=8"
FILE_DATABASE_URL="postgresql://admin:__CHANGE_ME__@postgres:5432/cleaning_ops_files?schema=public&connection_limit=8"
CORE_DATABASE_URL="postgresql://admin:__CHANGE_ME__@postgres:5432/cleaning_ops_core?schema=public&connection_limit=8"
GPS_DATABASE_URL="postgresql://admin:__CHANGE_ME__@postgres:5432/cleaning_ops_gps?schema=public&connection_limit=8"
TICKET_DATABASE_URL="postgresql://admin:__CHANGE_ME__@postgres:5432/cleaning_ops_tickets?schema=public&connection_limit=8"
NOTIFICATION_DATABASE_URL="postgresql://admin:__CHANGE_ME__@postgres:5432/cleaning_ops_notifications?schema=public&connection_limit=8"
MATERIAL_DATABASE_URL="postgresql://admin:__CHANGE_ME__@postgres:5432/cleaning_ops_materials?schema=public&connection_limit=8"
SCHEDULE_DATABASE_URL="postgresql://admin:__CHANGE_ME__@postgres:5432/cleaning_ops_schedule?schema=public&connection_limit=8"
CHAT_DATABASE_URL="postgresql://admin:__CHANGE_ME__@postgres:5432/cleaning_ops_chat?schema=public&connection_limit=8"

# --- Порты сервисов ---------------------------------------------------------
# Внутренние порты контейнеров (FR-3). Публикация в tailnet — 8111…8119 в том же
# каноническом порядке (решение O1 по PRD): auth=8111 … chat=8119.
PORT=3001
AUTH_SERVICE_PORT=3001
FILE_SERVICE_PORT=3002
CORE_SERVICE_PORT=3003
GPS_SERVICE_PORT=3004
TICKET_SERVICE_PORT=3005
NOTIFICATION_SERVICE_PORT=3006
MATERIAL_SERVICE_PORT=3007
SCHEDULE_SERVICE_PORT=3008
CHAT_SERVICE_PORT=3009

# --- Внутренние URL сервис-к-сервису ---------------------------------------
# ВНИМАНИЕ: FILE_SERVICE_URL — в ЕДИНСТВЕННОМ числе, именно это имя читает
# core-service (backend/core-service/src/config/configuration.ts). Имена из
# старого /opt-стенда (FILES_SERVICE_URL и т.п.) не подходят.
AUTH_SERVICE_URL=http://auth:3001
FILE_SERVICE_URL=http://files:3002
CORE_SERVICE_URL=http://core:3003
GPS_SERVICE_URL=http://gps:3004
TICKET_SERVICE_URL=http://tickets:3005
NOTIFICATION_SERVICE_URL=http://notifications:3006

# --- Сервисная учётка внутренних вызовов (chat, material, schedule) ---------
# Решение O4: пароль РАВЕН паролю seed-администратора (admin123), иначе
# межсервисные вызовы получают 401/502 из-за расхождения с seed.
SERVICE_AUTH_EMAIL=admin
SERVICE_AUTH_PASSWORD=admin123

# --- Auth / JWT (auth-service validation в NODE_ENV=production) -------------
# Требования: ≥32 символа и РАЗНЫЕ значения (backend/auth-service/src/config/validation.ts).
# <GEN> gen-env.sh: openssl rand -hex 32 (64 hex-символа) каждое, гарантированно разные.
JWT_ACCESS_SECRET=__CHANGE_ME__
JWT_REFRESH_SECRET=__CHANGE_ME__
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d
# THROTTLE_LOGIN_LIMIT / THROTTLE_GLOBAL_LIMIT НЕ задаются: дефолты 5/мин и
# 100/мин сохраняются как в проде (решение O6).

# --- RabbitMQ / schedule / escalation --------------------------------------
RABBITMQ_URL=amqp://admin:__CHANGE_ME__@rabbitmq:5672
# gps читает RABBITMQ_ENABLED, notifications — NOTIFICATION_RABBITMQ_ENABLED.
RABBITMQ_ENABLED=true
NOTIFICATION_RABBITMQ_ENABLED=true
# O5: стенд прод-подобный, фоновые проходы schedule включены. Для прогонов e2e
# поставьте false и выполните `bash deploy/vps/redeploy.sh`.
SCHEDULE_CRON_ENABLED=true
SCHEDULE_MISSED_CHECKIN_INTERVAL_MS=300000
SCHEDULE_AUTO_CHECKOUT_MINUTES=15

ESCALATION_NEW_TO_ACCEPT_MIN=5
ESCALATION_ACCEPT_TO_ARRIVE_MIN=15
ESCALATION_ARRIVE_TO_DONE_MIN=60

# --- Firebase (O7: пусто ⇒ мок-адаптер push) -------------------------------
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# --- Фронтенд (build-time, передаётся как build-arg в Dockerfile.web) -------
# Относительный /api: фронт ходит в nginx своего origin, nginx раскидывает по
# сервисам (§4). VITE_WS_URL НЕ задаётся — WebSocket-upgrade делает nginx.
VITE_API_URL=/api
# Mapbox-токен пустой ⇒ карта показывает заглушку «ключ не настроен» (O7).
VITE_MAPBOX_TOKEN=
