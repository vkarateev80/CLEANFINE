# Общие заголовки проксирования для обоих фронтендов (System Design v2, §2, FR-5).
# Подключается через `include /etc/nginx/proxy_params;` в каждом location /api/*.
# Файл монтируется из deploy/vps/nginx-proxy_params (и лежит в образе Dockerfile.web).

proxy_http_version 1.1;
proxy_set_header Host $host;
proxy_set_header X-Real-IP $remote_addr;
proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
proxy_set_header X-Forwarded-Proto $scheme;
# Backend — NestJS/Express; keep-alive до upstream позволяет не рвать соединение
# на каждый запрос (для обычных /api/* — пустая Connection, апгрейд задаётся
# отдельно в location /socket.io/).
proxy_set_header Connection "";
