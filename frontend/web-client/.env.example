# Пример окружения портала заказчика. Скопируйте в .env.local и подставьте свои
# значения: .env.local в git не коммитится (.gitignore).

# База REST. Пусто — относительный /api: в dev его раскидывает прокси Vite,
# в прод-сборке — reverse-proxy перед сервисами. Абсолютный адрес нужен только
# для стенда без прокси.
VITE_API_URL=

# Адрес chat-service для socket.io. В dev задаётся ЯВНО: dev-сервер Vite занимает
# путь /socket.io под собственный HMR-канал, поэтому WebSocket-шлюз через прокси
# не проходит (подробности — в vite.config.ts). В прод-сборке переменную не
# задают: пустое значение означает «тот же origin».
VITE_WS_URL=http://localhost:3009

# UUID сотрудника (ADMIN), с которым портал открывает DIRECT-чат. Обязателен для
# экрана /chat: справочник /api/users закрыт для роли CLIENT (403), поэтому id
# приходит конфигурацией, а не запросом.
VITE_MANAGER_USER_ID=
