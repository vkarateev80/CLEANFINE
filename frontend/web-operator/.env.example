# Пример окружения рабочего места оператора. Скопируйте в .env.local.

# База REST. Пусто — относительный /api: в dev его раскидывает прокси Vite,
# в прод-сборке — nginx того же origin.
VITE_API_URL=

# Адрес chat-service для socket.io в dev (dev-сервер Vite занимает /socket.io
# под HMR, см. vite.config.ts). В проде не задаётся: тот же origin.
VITE_WS_URL=http://localhost:3009
