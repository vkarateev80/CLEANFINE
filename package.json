{
  "name": "cleaning-ops",
  "version": "0.1.0",
  "private": true,
  "description": "CLEANFINE — система управления клининговыми работами (монорепо, устав М0)",
  "engines": {
    "node": ">=18"
  },
  "packageManager": "pnpm@8.0.0",
  "scripts": {
    "build:shared": "pnpm --filter @cleaning-ops/shared build",
    "build": "pnpm build:shared && pnpm -r --if-present build",
    "lint": "eslint \"backend/*/src/**/*.{ts,tsx}\" \"frontend/*/src/**/*.{ts,tsx}\" \"shared/{types,constants,utils}/**/*.{ts,tsx}\" --max-warnings 0",
    "lint:fix": "pnpm lint -- --fix",
    "typecheck": "pnpm --filter @cleaning-ops/shared typecheck && pnpm -r --if-present typecheck",
    "test": "pnpm -r --if-present test",
    "test:e2e": "pnpm -r --if-present test:e2e",
    "prisma:clients": "node scripts/ci/prisma-clients.mjs",
    "format:check": "prettier --check package.json pnpm-workspace.yaml .prettierrc eslint.config.mjs \"backend/**/*.{ts,tsx}\" \"frontend/**/*.{ts,tsx}\" \"shared/**/*.{ts,tsx}\" \"test/**/*.{ts,tsx}\" \"scripts/**/*.{mjs,js}\"",
    "format:write": "prettier --write package.json pnpm-workspace.yaml .prettierrc eslint.config.mjs \"backend/**/*.{ts,tsx}\" \"frontend/**/*.{ts,tsx}\" \"shared/**/*.{ts,tsx}\" \"test/**/*.{ts,tsx}\" \"scripts/**/*.{mjs,js}\""
  },
  "devDependencies": {
    "@typescript-eslint/eslint-plugin": "^7.18.0",
    "@typescript-eslint/parser": "^7.18.0",
    "eslint": "^8.57.1",
    "prettier": "^3.3.3"
  }
}
